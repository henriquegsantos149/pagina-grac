{
  "headers": [
    {
      "source": "/posgrac/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/posgrac/ementa-pós-grac.pdf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, must-revalidate"
        }
      ]
    },
    {
      "source": "/posgrac/(favicon.*|logo.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(posgrac/)?bruno/?",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(posgrac/)?dhyogo/?",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/posgrac/dhyogo/?",
      "dest": "/dhyogo/index.html"
    },
    {
      "src": "/dhyogo/?",
      "dest": "/dhyogo/index.html"
    },
    {
      "src": "/posgrac/bruno/?",
      "dest": "/bruno/index.html"
    },
    {
      "src": "/bruno/?",
      "dest": "/bruno/index.html"
    },
    {
      "src": "/posgrac/(.*)",
      "dest": "/posgrac/index.html"
    }
  ]
}
