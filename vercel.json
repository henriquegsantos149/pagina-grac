{
  "headers": [
    {
      "source": "/posgrac/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/posgrac/ementa-pós-grac.pdf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, must-revalidate"
        }
      ]
    },
    {
      "source": "/posgrac/(favicon.*|logo.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/posgrac/bruno",
      "destination": "/bruno/index.html"
    },
    {
      "source": "/posgrac/bruno/",
      "destination": "/bruno/index.html"
    },
    {
      "source": "/posgrac/dhyogo",
      "destination": "/dhyogo/index.html"
    },
    {
      "source": "/posgrac/dhyogo/",
      "destination": "/dhyogo/index.html"
    },
    {
      "source": "/bruno",
      "destination": "/bruno/index.html"
    },
    {
      "source": "/dhyogo",
      "destination": "/dhyogo/index.html"
    },
    {
      "source": "/posgrac",
      "destination": "/index.html"
    },
    {
      "source": "/posgrac/",
      "destination": "/index.html"
    },
    {
      "source": "/posgrac/:path*",
      "destination": "/:path*"
    }
  ]
}
